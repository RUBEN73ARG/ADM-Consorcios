# ==============================================================================
# PLANTILLA DE VARIABLES DE ENTORNO DEL FRONTEND WEB3 (React + Vite + Ethers v6)
# ==============================================================================
# Copiar este archivo como `.env` dentro de `/frontend` y completar con tus API Keys.
# NUNCA subir el archivo `.env` real a GitHub (está protegido por `.gitignore`).

# 1. Nodo RPC de Alchemy para Ethereum Sepolia (Chain ID: 11155111)
VITE_ALCHEMY_SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/TU_ALCHEMY_API_KEY

# 2. API Key de Etherscan para consultas de contratos verificados y explorador de bloques
VITE_ETHERSCAN_API_KEY=TU_ETHERSCAN_API_KEY

# 3. Token JWT de Pinata para anclaje de facturas y comprobantes de Hitos en IPFS
VITE_PINATA_JWT=TU_PINATA_JWT_TOKEN

# ==============================================================================
# PLANTILLA DE VARIABLES DE ENTORNO — ADM-CONSORCIOS (ConsorcioDAO V2)
# ==============================================================================
# Copiar este archivo como `.env` en la raíz del proyecto y completar con tus credenciales.
# NUNCA commitear el archivo `.env` real al repositorio público (excluido en `.gitignore`).

# 1. Billetera Deployer (Usar Keystore encriptado de Foundry o `--unlocked`, nunca exponer en GitHub)
PRIVATE_KEY=

# 2. Proveedor de Nodo JSON-RPC (Alchemy — Ethereum Sepolia Testnet, Chain ID 11155111)
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/TU_ALCHEMY_API_KEY

# 3. API Key de Etherscan para verificación automática de contratos (`forge script --verify`)
ETHERSCAN_API_KEY=TU_ETHERSCAN_API_KEY

# 4. Credenciales de Pinata IPFS para almacenamiento descentralizado de rendición de cuentas (CID)
PINATA_API_KEY=TU_PINATA_API_KEY
PINATA_API_SECRET=TU_PINATA_API_SECRET
PINATA_JWT=TU_PINATA_JWT_TOKEN
